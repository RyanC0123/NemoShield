APP_NAME=NemoShield
APP_ENV=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

NVIDIA_API_KEY=


# Arduino 101 (leave ARDUINO_PORT empty to auto-detect)
ARDUINO_PORT=
ARDUINO_BAUD=9600
ARDUINO_SIMULATE=false

# Required to accept normalized events at POST /api/events.
# Set a long random value and send it as an Authorization: Bearer token.
NEMOSHIELD_INGEST_TOKEN=